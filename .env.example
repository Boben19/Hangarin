# Copy this file to .env (git already ignores that name) and fill it in.
#
# 1. Make a secret key. Run this once and paste ONLY the output after the = sign:
#      python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
#    Never leave the placeholder in, the site refuses to start with it.
DJANGO_SECRET_KEY=

# Local laptop only. Leave this out (or False) on PythonAnywhere.
# DJANGO_DEBUG=True

# Comma separated. Add your own domain if you use one.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,boben19.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://boben19.pythonanywhere.com

# Optional: hide the admin somewhere less obvious (keep the trailing slash)
# DJANGO_ADMIN_URL=manage-hangarin/

# Social login. Callback URLs to register with each provider
# (swap in your real domain when deployed):
#   Google   http://127.0.0.1:8000/accounts/google/login/callback/
#   Facebook http://127.0.0.1:8000/accounts/facebook/login/callback/
#   GitHub   http://127.0.0.1:8000/accounts/github/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# GitHub: Settings -> Developer settings -> OAuth Apps (steps are in the README)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: real email for password resets and address confirmation.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Hangarin <you@example.com>

# The domain django-allauth puts in email links. Optional: if you leave it out,
# the first real host in DJANGO_ALLOWED_HOSTS is used.
# DJANGO_SITE_DOMAIN=boben19.pythonanywhere.com
